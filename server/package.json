{
  "name": "smartspare-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src --ext .ts",
    "prisma:push": "prisma db push --skip-generate && prisma generate",
    "seed": "tsx prisma/seed.ts",
    "assistant:test": "tsx src/assistant/check-intents.ts --held-out",
    "assistant:test:live": "node -r dotenv/config node_modules/tsx/dist/cli.mjs src/assistant/check-live.ts",
    "assistant:test:http": "node -r dotenv/config node_modules/tsx/dist/cli.mjs src/assistant/check-http.ts",
    "assistant:test:upgrade": "tsx src/assistant/check-upgrade.ts",
    "assistant:test:upgrade:live": "node -r dotenv/config node_modules/tsx/dist/cli.mjs src/assistant/check-upgrade-live.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "prisma": "^6.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
