// ============================================================
// FINANCE
// ============================================================
// type: ASSET LIABILITY EQUITY REVENUE COGS EXPENSE
model Account {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  name       String
  type       String
  parentId   Int?
  parent     Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children   Account[] @relation("AccountTree")
  isGroup    Boolean   @default(false)
  // systemKey identifies accounts used by auto-posting: CASH BANK AR INVENTORY AP VAT_INPUT VAT_OUTPUT SALES COGS FREIGHT_CLEARING OPENING_EQUITY ROUND_OFF GRNI ...
  systemKey  String?   @unique
  isBank     Boolean   @default(false)
  isActive   Boolean   @default(true)
  lines      JournalLine[]
}

model JournalEntry {
  id         Int       @id @default(autoincrement())
  entryNo    String    @unique
  entryDate  DateTime
  entryType  String    @default("AUTO") // AUTO JOURNAL DEBIT_NOTE CREDIT_NOTE OPENING RECEIPT PAYMENT
  sourceType String?
  sourceId   Int?
  sourceNo   String?
  narration  String?
  status     String    @default("POSTED") // POSTED REVERSED
  totalDebit Decimal   @default(0) @db.Decimal(18, 2)
  createdBy  Int?
  createdAt  DateTime  @default(now())
  lines      JournalLine[]

  @@index([sourceType, sourceId])
}

model JournalLine {
  id          Int          @id @default(autoincrement())
  journalId   Int
  journal     JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId   Int
  account     Account      @relation(fields: [accountId], references: [id])
  debit       Decimal      @default(0) @db.Decimal(18, 2)
  credit      Decimal      @default(0) @db.Decimal(18, 2)
  // subledger party
  partyType   String?      // CUSTOMER | SUPPLIER
  partyId     Int?
  description String?
  vatCode     String?
  vatAmount   Decimal      @default(0) @db.Decimal(18, 2)

  @@index([accountId])
  @@index([partyType, partyId])
}

// Receipts (customer/other) & Payments (supplier/other). mode: CASH | BANK
model Voucher {
  id           Int      @id @default(autoincrement())
  voucherNo    String   @unique
  voucherType  String   // RECEIPT | PAYMENT
  mode         String   @default("BANK") // CASH | BANK
  voucherDate  DateTime
  partyType    String?  // CUSTOMER | SUPPLIER | OTHER
  partyId      Int?
  accountId    Int      // cash/bank account
  counterAccountId Int? // for OTHER party
  amount       Decimal  @db.Decimal(18, 2)
  reference    String?  // cheque / txn ref
  narration    String?
  status       String   @default("POSTED") // DRAFT POSTED CANCELLED
  journalId    Int?
  createdBy    Int?
  createdAt    DateTime @default(now())
  allocations  VoucherAllocation[]
}

// Allocates a voucher amount to invoices (docType SALES_INVOICE | PURCHASE_INVOICE | PURCHASE_ORDER(advance))
model VoucherAllocation {
  id        Int     @id @default(autoincrement())
  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  docType   String
  docId     Int
  docNo     String?
  amount    Decimal @db.Decimal(18, 2)
}

// Credit / Debit notes. noteType CREDIT | DEBIT ; partyType CUSTOMER | SUPPLIER
model Note {
  id         Int      @id @default(autoincrement())
  noteNo     String   @unique
  noteType   String
  partyType  String
  partyId    Int
  noteDate   DateTime
  refType    String?
  refId      Int?
  refNo      String?
  subtotal   Decimal  @default(0) @db.Decimal(18, 2)
  vatAmount  Decimal  @default(0) @db.Decimal(18, 2)
  total      Decimal  @default(0) @db.Decimal(18, 2)
  reason     String?
  status     String   @default("POSTED") // DRAFT POSTED CANCELLED
  journalId  Int?
  createdBy  Int?
  createdAt  DateTime @default(now())
}

// ============================================================
// AMC (Annual Maintenance Contract)
// ============================================================
// contractType: COMPREHENSIVE | LABOUR_ONLY | PARTS_ONLY
// status:       DRAFT | ACTIVE | EXPIRED | RENEWED | CANCELLED
model AmcContract {
  id              Int          @id @default(autoincrement())
  contractNo      String       @unique
  customerId      Int
  customer        Customer     @relation(fields: [customerId], references: [id])
  productId       Int?
  product         Product?     @relation(fields: [productId], references: [id])
  equipmentDesc   String?
  serialNo        String?
  contractType    String       @default("COMPREHENSIVE")
  startDate       DateTime
  endDate         DateTime
  amount          Decimal      @default(0) @db.Decimal(18, 2)
  vatRate         Decimal      @default(5) @db.Decimal(6, 2)
  vatAmount       Decimal      @default(0) @db.Decimal(18, 2)
  total           Decimal      @default(0) @db.Decimal(18, 2)
  visitCount      Int          @default(4)
  status          String       @default("DRAFT")
  salesmanId      Int?
  notes           String?      @db.Text
  renewedFromId   Int?
  createdBy       Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  visits          AmcVisit[]

  @@index([customerId])
  @@index([status])
  @@index([endDate])
}

// visitType: PREVENTIVE | CORRECTIVE | EMERGENCY
// status:    SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
model AmcVisit {
  id           Int         @id @default(autoincrement())
  contractId   Int
  contract     AmcContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  visitNo      Int
  scheduledDate DateTime
  completedDate DateTime?
  visitType    String      @default("PREVENTIVE")
  status       String      @default("SCHEDULED")
  technicianName String?
  findings     String?     @db.Text
  partsUsed    String?     @db.Text
  createdAt    DateTime    @default(now())

  @@index([contractId])
  @@index([scheduledDate])
}

// ============================================================
// HR (Human Resources)
// ============================================================

model Department {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  managerId   Int?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  employees   Employee[]
}

model Designation {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  employees   Employee[]
}

// gender: MALE | FEMALE | OTHER
// employmentType: FULL_TIME | PART_TIME | CONTRACT | PROBATION
// status: ACTIVE | RESIGNED | TERMINATED | ON_LEAVE
model Employee {
  id               Int          @id @default(autoincrement())
  employeeNo       String       @unique
  firstName        String
  lastName         String
  fullName         String
  gender           String       @default("MALE")
  dob              DateTime?
  nationality      String?
  phone            String?
  email            String?
  address          String?      @db.Text
  departmentId     Int?
  department       Department?  @relation(fields: [departmentId], references: [id])
  designationId    Int?
  designation      Designation? @relation(fields: [designationId], references: [id])
  branchId         Int?
  employmentType   String       @default("FULL_TIME")
  joinDate         DateTime
  endDate          DateTime?
  basicSalary      Decimal      @default(0) @db.Decimal(18, 2)
  housingAllowance Decimal      @default(0) @db.Decimal(18, 2)
  transportAllowance Decimal    @default(0) @db.Decimal(18, 2)
  otherAllowance   Decimal      @default(0) @db.Decimal(18, 2)
  status           String       @default("ACTIVE")
  passportNo       String?
  passportExpiry   DateTime?
  visaNo           String?
  visaExpiry       DateTime?
  emiratesId       String?
  emiratesExpiry   DateTime?
  notes            String?      @db.Text
  createdBy        Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  attendance       Attendance[]
  leaveRequests    LeaveRequest[]
  payrolls         Payroll[]

  @@index([departmentId])
  @@index([status])
}

// attendanceType: REGULAR | OVERTIME | PUBLIC_HOLIDAY | SICK
// status: PRESENT | ABSENT | HALF_DAY | ON_LEAVE | HOLIDAY
model Attendance {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  employee       Employee  @relation(fields: [employeeId], references: [id])
  attendanceDate DateTime
  checkIn        DateTime?
  checkOut       DateTime?
  hoursWorked    Decimal   @default(0) @db.Decimal(6, 2)
  overtimeHours  Decimal   @default(0) @db.Decimal(6, 2)
  status         String    @default("PRESENT")
  remarks        String?
  createdAt      DateTime  @default(now())

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@index([employeeId])
}

// leaveType: ANNUAL | SICK | UNPAID | MATERNITY | PATERNITY | EMERGENCY | COMPASSIONATE
// status: PENDING | APPROVED | REJECTED | CANCELLED
model LeaveRequest {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  employee     Employee  @relation(fields: [employeeId], references: [id])
  leaveType    String    @default("ANNUAL")
  fromDate     DateTime
  toDate       DateTime
  days         Decimal   @default(1) @db.Decimal(6, 2)
  reason       String?   @db.Text
  status       String    @default("PENDING")
  approvedBy   Int?
  approvedAt   DateTime?
  remarks      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([fromDate, toDate])
}

// Payroll per employee per period (e.g. monthly)
// status: DRAFT | PROCESSED | PAID
model Payroll {
  id                Int       @id @default(autoincrement())
  payrollNo         String    @unique
  employeeId        Int
  employee          Employee  @relation(fields: [employeeId], references: [id])
  periodFrom        DateTime
  periodTo          DateTime
  basicSalary       Decimal   @default(0) @db.Decimal(18, 2)
  housingAllowance  Decimal   @default(0) @db.Decimal(18, 2)
  transportAllowance Decimal  @default(0) @db.Decimal(18, 2)
  otherAllowance    Decimal   @default(0) @db.Decimal(18, 2)
  overtimePay       Decimal   @default(0) @db.Decimal(18, 2)
  deductions        Decimal   @default(0) @db.Decimal(18, 2)
  grossSalary       Decimal   @default(0) @db.Decimal(18, 2)
  netSalary         Decimal   @default(0) @db.Decimal(18, 2)
  daysWorked        Decimal   @default(0) @db.Decimal(6, 2)
  daysAbsent        Decimal   @default(0) @db.Decimal(6, 2)
  overtimeHours     Decimal   @default(0) @db.Decimal(6, 2)
  notes             String?   @db.Text
  status            String    @default("DRAFT")
  processedBy       Int?
  processedAt       DateTime?
  createdBy         Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([employeeId])
  @@index([periodFrom])
  @@index([status])
}
